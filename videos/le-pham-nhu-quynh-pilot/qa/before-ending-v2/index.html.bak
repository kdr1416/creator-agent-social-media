</div>
<script>
const tl=gsap.timeline({paused:true});
const near={x:399,y:720},far={x:360,y:855};
function setArm(prefix,sx,sy,ex,ey,l1,l2,bend){const dx=ex-sx,dy=ey-sy,d=Math.min(Math.hypot(dx,dy),l1+l2-.01),a=Math.atan2(dy,dx),b=Math.acos(Math.max(-1,Math.min(1,(l1*l1+d*d-l2*l2)/(2*l1*d))));const x=sx+l1*Math.cos(a+b*bend),y=sy+l1*Math.sin(a+b*bend);document.getElementById(prefix+'-upper').setAttribute('d',`M${sx},${sy}L${x},${y}`);document.getElementById(prefix+'-lower').setAttribute('d',`M${x},${y}L${ex},${ey}`);document.getElementById(prefix+'-hand').setAttribute('cx',ex);document.getElementById(prefix+'-hand').setAttribute('cy',ey);}
function pose(){setArm('near',262,647,near.x,near.y,115,115,1);setArm('far',169,650,far.x,far.y,145,145,1);}
pose();
const heroes=['#hero-competence','#hero-personality','#hero-goal'],pages=['#page-competence','#page-personality','#page-goal'],labels=['#label-ability','#label-personality','#label-goal'];
gsap.set(heroes,{opacity:0,y:70,scale:.6,transformOrigin:'50% 100%'});gsap.set(pages,{opacity:0});gsap.set(labels,{opacity:0,y:8});gsap.set('#clip',{opacity:0});gsap.set('#turning-page',{opacity:0});gsap.set(['#campus-a','#campus-b'],{opacity:0,y:20});
for(const id of ['#route-a','#route-b']){const el=document.querySelector(id),len=el.getTotalLength();gsap.set(el,{strokeDasharray:len,strokeDashoffset:len});}
tl.fromTo('#portfolio',{y:30},{y:0,duration:.8,ease:'power2.inOut'},0)
 .to(far,{x:360,y:825,duration:.8,ease:'power2.inOut',onUpdate:pose},0)
 .to(near,{x:401,y:637,duration:.6,ease:'power2.inOut',onUpdate:pose},.3)
 .to('#cover',{scaleX:0,svgOrigin:'345 775',duration:.55,ease:'power2.inOut'},.8)
 .set('#cover',{opacity:0},1.35)
 .to(near,{x:434,y:694,duration:.4,ease:'power2.inOut',onUpdate:pose},1.2)
 .to('#page-competence',{opacity:1,duration:.2},1.35)
 .to('#hero-competence',{opacity:1,y:0,scale:1,duration:.45,ease:'back.out(1.1)'},1.5)
 .set('#page-competence',{opacity:0},1.8)
 .to('#label-ability',{opacity:1,y:0,duration:.15},1.92)
 .to('#gear',{rotation:24,svgOrigin:'460 473',duration:.55,ease:'power2.out'},1.7)
 .to('#hero-competence',{opacity:0,y:-20,scale:.94,duration:.2},2.38)
 .to('#label-ability',{opacity:0,duration:.12},2.45)
 .set('#turning-page',{opacity:1,scaleX:1},2.4)
 .to('#turning-page',{scaleX:0,svgOrigin:'365 760',duration:.25,ease:'power2.inOut'},2.42)
 .set('#turning-page',{opacity:0},2.67)
 .set('#page-competence',{opacity:0},2.57)
 .to('#page-personality',{opacity:1,duration:.12},2.57)
 .to('#hero-personality',{opacity:1,y:0,scale:1,duration:.25,ease:'power2.out'},2.57)
 .set('#page-personality',{opacity:0},2.88)
 .to('#label-personality',{opacity:1,y:0,duration:.12},2.6)
 .to(near,{x:410,y:646,duration:.28,ease:'power2.inOut',onUpdate:pose},2.35)
 .to('#hero-personality',{opacity:0,y:-15,scale:.95,duration:.18},3.2)
 .to('#label-personality',{opacity:0,duration:.1},3.22)
 .set('#turning-page',{opacity:1,scaleX:1},3.18)
 .to('#turning-page',{scaleX:0,svgOrigin:'365 760',duration:.25,ease:'power2.inOut'},3.21)
 .set('#turning-page',{opacity:0},3.46)
 .set('#page-personality',{opacity:0},3.31)
 .to('#page-goal',{opacity:1,duration:.12},3.31)
 .to('#hero-goal',{opacity:1,y:0,scale:1,duration:.3,ease:'power2.out'},3.31)
 .set('#page-goal',{opacity:0},3.62)
 .to('#label-goal',{opacity:1,y:0,duration:.12},3.36)
 .fromTo('#needle',{rotation:-55,svgOrigin:'466 467'},{rotation:20,svgOrigin:'466 467',duration:.65,ease:'power2.inOut'},3.2)
 .to(near,{x:430,y:701,duration:.35,ease:'power2.inOut',onUpdate:pose},3.25)
 .to('#hero-goal',{opacity:0,y:-18,scale:.94,duration:.3},4.1)
 .to('#label-goal',{opacity:0,duration:.18},4.12)
 .to(near,{x:367,y:705,duration:.55,ease:'power2.inOut',onUpdate:pose},4.05)
 .set('#cover',{opacity:1,scaleX:0},4.25)
