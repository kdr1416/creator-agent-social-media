# Phase 0 .gitignore — dựa trên .gitignore cũ, cộng thêm quy tắc cho creator workflow
# Lưu ý: dòng AGENTS.md cũ đã được bỏ, vì AGENTS.md mới là điểm vào được commit thủ công trong Phase 0.

__pycache__/
*.pyc
*.db
*.db-shm
*.db-wal
*.db-journal
.env
output/
youtube/channels/
agent/active_project.json

# Generated AI tool configs (run: python setup.py)
.claude/commands/fk-*
.agents/skills/fk-*
.fk-setup.json

# design-sync
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
extension/_metadata/

# oh-my-claudecode session state
.omc/
.agent/
flow_session_project.json
.venv/
venv/
*.mp3
scratch/

series_manifest.json

# Node packages
node_modules/
**/node_modules/

# Temp & build artifacts
temp_frames/
*.log
*.zip
*.mp4
*.mov
*.avi
*.mkv

# Browser QA profiles & binary caches
*profile*/
**/*profile*/**
*browser-art*/
*study-browser*/
**/Crashpad/**
**/DawnGraphiteCache/**
**/DawnWebGPUCache/**
**/GPUCache/**
**/GrShaderCache/**
**/ShaderCache/**
**/*Code Cache*/**
**/Default/Cache/**
**/Default/Network/**
*.wasm
*.dll
*.pma

# Phase 0/1 creator workflow: không commit output nặng và snapshot debug
*.wav
projects/*/inputs/*.wav
projects/*/build/
projects/*/inputs/source_audio.wav
**/snapshots_debug/
**/snapshots_verify_*/
assets/stock/
assets/footage/
**/*.mp4
